---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';
import { supabase, PLATFORMS, DEFAULT_PLATFORM_SETTINGS, type PlatformSetting, type Profile } from '../lib/supabase';

export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect(`${base}login`);

const { data: profileData } = await supabase.from('profiles').select('*').eq('id', user.id).single();
const profile = profileData as Profile | null;
const isPaid = profile?.plan === 'paid';

const { data: settingsData } = await supabase.from('platform_settings').select('*').eq('user_id', user.id);
const settings = (settingsData ?? []) as PlatformSetting[];

const settingsByPlatform = Object.fromEntries(settings.map((s) => [s.platform, s]));
---

<Layout title="Einstellungen">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-2xl font-semibold tracking-tight">Plattform-Einstellungen</h1>

    {isPaid ? (
      <p class="mt-1 text-sm text-slate-500">
        Aktiviere die Plattformen, für die Content generiert werden soll, und lege Anzahl sowie Textlänge fest.
        Deaktivierte Plattformen (oder Anzahl 0) werden bei der Generierung übersprungen.
      </p>
    ) : (
      <div class="mt-6 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        <p>
          Im kostenlosen Plan generierst du automatisch Posts für <strong>LinkedIn und Facebook</strong> —
          eine Auswahl weiterer Plattformen sowie das Anpassen von Anzahl und Textlänge ist nicht möglich.
        </p>
        <p class="mt-2">Mit einem bezahlten Plan kannst du alle 8 Plattformen frei aktivieren und individuell konfigurieren.</p>
      </div>
    )}

    {isPaid && (
      <form id="settings-form" class="mt-6 space-y-4">
        {
          PLATFORMS.map((platform) => {
            const current = settingsByPlatform[platform] ?? DEFAULT_PLATFORM_SETTINGS[platform];
            return (
              <fieldset class="rounded-lg border border-slate-200 p-4">
                <legend class="flex items-center gap-2 px-1 text-sm font-semibold text-slate-900">
                  <input
                    type="checkbox"
                    class="platform-active-toggle h-4 w-4 rounded border-slate-300"
                    data-platform={platform}
                    name={`${platform}_active`}
                    checked={current.active}
                  />
                  {platform}
                </legend>
                <div class="platform-fields mt-2 grid grid-cols-3 gap-3">
                  <div>
                    <label class="block text-xs font-medium text-slate-600">Anzahl Posts</label>
                    <input
                      type="number"
                      min="0"
                      max="10"
                      name={`${platform}_post_count`}
                      value={current.post_count}
                      class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600">Min. Zeichen</label>
                    <input
                      type="number"
                      min="1"
                      name={`${platform}_min_length`}
                      value={current.min_length}
                      class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-slate-600">Max. Zeichen</label>
                    <input
                      type="number"
                      min="1"
                      name={`${platform}_max_length`}
                      value={current.max_length}
                      class="mt-1 block w-full rounded-md border border-slate-300 px-2 py-1.5 text-sm"
                    />
                  </div>
                </div>
              </fieldset>
            );
          })
        }

        <button
          id="save-btn"
          type="submit"
          class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700"
        >
          Speichern
        </button>
      </form>
    )}

    <div id="status" class="mt-4 hidden rounded-md border p-3 text-sm"></div>
  </div>
</Layout>

<script define:vars={{ platforms: PLATFORMS }}>
  const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  const form = document.getElementById('settings-form');
  const saveBtn = document.getElementById('save-btn');
  const statusEl = document.getElementById('status');

  function updateFieldsetState(checkbox) {
    const fieldset = checkbox.closest('fieldset');
    const wrapper = fieldset?.querySelector('.platform-fields');
    wrapper?.classList.toggle('opacity-40', !checkbox.checked);
    wrapper?.classList.toggle('pointer-events-none', !checkbox.checked);
  }

  document.querySelectorAll('.platform-active-toggle').forEach((checkbox) => {
    updateFieldsetState(checkbox);
    checkbox.addEventListener('change', () => updateFieldsetState(checkbox));
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Speichert...';
    }

    const formData = new FormData(form);
    const settings = {};
    for (const platform of platforms) {
      settings[platform] = {
        active: formData.get(`${platform}_active`) === 'on',
        post_count: formData.get(`${platform}_post_count`),
        min_length: formData.get(`${platform}_min_length`),
        max_length: formData.get(`${platform}_max_length`)
      };
    }

    const res = await fetch(`${base}api/settings`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings })
    });
    const data = await res.json();

    statusEl.classList.remove('hidden');
    if (res.ok && data.success) {
      statusEl.className = 'mt-4 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800';
      statusEl.textContent = 'Einstellungen gespeichert.';
    } else {
      statusEl.className = 'mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800';
      statusEl.textContent = data.error || 'Fehler beim Speichern.';
    }

    if (saveBtn) {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Speichern';
    }
  });
</script>
