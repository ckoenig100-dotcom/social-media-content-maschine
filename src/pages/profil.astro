---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';
import { supabase, getEffectivePlan, isTrialActive, type Profile } from '../lib/supabase';

export const prerender = false;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect(`${base}login`);

const { data } = await supabase.from('profiles').select('*').eq('id', user.id).single();
const profile = data as Profile | null;
const effectivePlan = getEffectivePlan(profile);
const trialActive = isTrialActive(profile);
---

<Layout title="Mein Profil">
  <div class="mx-auto max-w-lg">
    <h1 class="text-2xl font-semibold tracking-tight">Mein Profil</h1>
    <p class="mt-1 text-sm text-slate-500">
      Plan: <span class="font-medium">{effectivePlan === 'paid' ? 'Bezahlt' : 'Kostenlos'}</span>
      {trialActive && <span class="ml-1 text-xs text-emerald-600">(24h-Testphase aktiv)</span>}
    </p>

    <form id="profile-form" class="mt-8 space-y-5">
      <div class="flex items-center gap-4">
        <img
          id="avatar-preview"
          src={profile?.avatar_url || `${base}profil.jpg`}
          alt="Profilbild"
          class="h-16 w-16 rounded-full border border-slate-200 object-cover"
        />
        <div>
          <label for="avatar" class="block text-sm font-medium text-slate-700">Profilbild</label>
          <input id="avatar" name="avatar" type="file" accept="image/*" class="mt-1.5 text-sm" />
        </div>
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-slate-700">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          value={profile?.name ?? ''}
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700">E-Mail</label>
        <input
          type="email"
          value={user.email}
          disabled
          class="mt-1.5 block w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-500"
        />
        <p class="mt-1 text-xs text-slate-400">Die Login-E-Mail kann hier nicht geändert werden.</p>
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-slate-700">Telefonnummer</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          value={profile?.phone ?? ''}
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>

      <button
        id="save-btn"
        type="submit"
        class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700"
      >
        Speichern
      </button>
    </form>

    <div id="status" class="mt-4 hidden rounded-md border p-3 text-sm"></div>

    <hr class="my-10 border-slate-200" />

    <h2 class="text-lg font-semibold tracking-tight">Passwort ändern</h2>
    <form id="password-form" class="mt-4 space-y-4">
      <div>
        <label for="new-password" class="block text-sm font-medium text-slate-700">Neues Passwort</label>
        <input
          id="new-password"
          name="newPassword"
          type="password"
          minlength="6"
          required
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>
      <div>
        <label for="new-password-confirm" class="block text-sm font-medium text-slate-700">Neues Passwort bestätigen</label>
        <input
          id="new-password-confirm"
          name="newPasswordConfirm"
          type="password"
          minlength="6"
          required
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>
      <button
        id="password-save-btn"
        type="submit"
        class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700"
      >
        Passwort ändern
      </button>
    </form>

    <div id="password-status" class="mt-4 hidden rounded-md border p-3 text-sm"></div>
  </div>
</Layout>

<script>
  const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  const form = document.getElementById('profile-form') as HTMLFormElement;
  const avatarInput = document.getElementById('avatar') as HTMLInputElement;
  const avatarPreview = document.getElementById('avatar-preview') as HTMLImageElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;

  avatarInput.addEventListener('change', () => {
    const file = avatarInput.files?.[0];
    if (file) avatarPreview.src = URL.createObjectURL(file);
  });

  function fileToBase64(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve((reader.result as string).split(',')[1]);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'Speichert...';

    const name = (document.getElementById('name') as HTMLInputElement).value;
    const phone = (document.getElementById('phone') as HTMLInputElement).value;
    const file = avatarInput.files?.[0];

    const payload: Record<string, unknown> = { name, phone };
    if (file) {
      payload.avatarBase64 = await fileToBase64(file);
      payload.avatarType = file.type;
    }

    const res = await fetch(`${base}api/profile`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    saveBtn.disabled = false;
    saveBtn.textContent = 'Speichern';
    statusEl.classList.remove('hidden');

    if (res.ok && data.success) {
      statusEl.className = 'mt-4 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800';
      statusEl.textContent = 'Profil gespeichert.';
    } else {
      statusEl.className = 'mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800';
      statusEl.textContent = data.error || 'Fehler beim Speichern.';
    }
  });

  const passwordForm = document.getElementById('password-form') as HTMLFormElement;
  const passwordSaveBtn = document.getElementById('password-save-btn') as HTMLButtonElement;
  const passwordStatusEl = document.getElementById('password-status') as HTMLDivElement;

  passwordForm.addEventListener('submit', async (e) => {
    e.preventDefault();

    const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
    const newPasswordConfirm = (document.getElementById('new-password-confirm') as HTMLInputElement).value;

    passwordStatusEl.classList.remove('hidden');

    if (newPassword !== newPasswordConfirm) {
      passwordStatusEl.className = 'mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800';
      passwordStatusEl.textContent = 'Die Passwörter stimmen nicht überein.';
      return;
    }

    passwordSaveBtn.disabled = true;
    passwordSaveBtn.textContent = 'Ändert...';

    const res = await fetch(`${base}api/change-password`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ newPassword })
    });
    const data = await res.json();

    passwordSaveBtn.disabled = false;
    passwordSaveBtn.textContent = 'Passwort ändern';

    if (res.ok && data.success) {
      passwordStatusEl.className = 'mt-4 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800';
      passwordStatusEl.textContent = 'Passwort geändert.';
      passwordForm.reset();
    } else {
      passwordStatusEl.className = 'mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800';
      passwordStatusEl.textContent = data.error || 'Fehler beim Ändern des Passworts.';
    }
  });
</script>
