---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Neuer Beitrag">
  <div class="mx-auto max-w-xl">
    <h1 class="text-2xl font-semibold tracking-tight">Neuen Content generieren</h1>
    <p class="mt-1 text-sm text-slate-500">
      Aus einem Thema werden automatisch 10 Posts für LinkedIn, Instagram, X und Facebook erstellt.
    </p>

    <form id="generate-form" class="mt-8 space-y-5">
      <div>
        <label for="thema" class="block text-sm font-medium text-slate-700">Thema *</label>
        <input
          id="thema"
          name="thema"
          type="text"
          required
          placeholder="z. B. Produktivität im Homeoffice"
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>

      <div>
        <label for="kontext" class="block text-sm font-medium text-slate-700">Kontext</label>
        <textarea
          id="kontext"
          name="kontext"
          rows="3"
          placeholder="Zusätzlicher Kontext, Artikel-Auszug, Kernaussagen..."
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        ></textarea>
      </div>

      <div>
        <label for="markenstimme" class="block text-sm font-medium text-slate-700">Markenstimme</label>
        <input
          id="markenstimme"
          name="markenstimme"
          type="text"
          placeholder="z. B. locker, professionell, humorvoll"
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>

      <div>
        <label for="zielgruppe" class="block text-sm font-medium text-slate-700">Zielgruppe</label>
        <input
          id="zielgruppe"
          name="zielgruppe"
          type="text"
          placeholder="z. B. Freelancer, B2B-Entscheider"
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>

      <div>
        <label for="kunde" class="block text-sm font-medium text-slate-700">Kunde (optional)</label>
        <input
          id="kunde"
          name="kunde"
          type="text"
          placeholder="Falls als Agentur-Service für einen Kunden"
          class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
        />
      </div>

      <button
        id="submit-btn"
        type="submit"
        class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
      >
        10 Posts generieren
      </button>
    </form>

    <div id="status" class="mt-6 hidden rounded-md border p-4 text-sm">
      <p id="status-text"></p>
      <div id="progress-wrap" class="mt-3 hidden">
        <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
          <div id="progress-bar" class="h-full w-0 rounded-full bg-slate-900 transition-[width] duration-500 ease-out"></div>
        </div>
        <p id="progress-percent" class="mt-1 text-right text-xs text-slate-400">0%</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  const form = document.getElementById('generate-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const statusEl = document.getElementById('status') as HTMLDivElement;
  const statusText = document.getElementById('status-text') as HTMLParagraphElement;
  const progressWrap = document.getElementById('progress-wrap') as HTMLDivElement;
  const progressBar = document.getElementById('progress-bar') as HTMLDivElement;
  const progressPercent = document.getElementById('progress-percent') as HTMLParagraphElement;

  let progressTimer: ReturnType<typeof setInterval> | undefined;

  function setProgress(percent: number) {
    progressBar.style.width = `${percent}%`;
    progressPercent.textContent = `${Math.round(percent)}%`;
  }

  function startFakeProgress() {
    const startTime = Date.now();
    setProgress(0);
    progressTimer = setInterval(() => {
      const elapsedSeconds = (Date.now() - startTime) / 1000;
      // Nähert sich asymptotisch 92% an, damit die Anzeige nie "fertig" suggeriert, bevor die Antwort da ist.
      const percent = 92 * (1 - Math.exp(-elapsedSeconds / 40));
      setProgress(percent);
    }, 300);
  }

  function stopFakeProgress() {
    if (progressTimer) clearInterval(progressTimer);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    submitBtn.disabled = true;
    submitBtn.textContent = 'Generiere Posts... (kann bis zu 2 Minuten dauern)';
    statusEl.className = 'mt-6 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600';
    statusText.textContent = 'Claude erstellt gerade 10 Posts und speichert sie in deinem Content-Kalender. Bitte warten...';
    progressWrap.classList.remove('hidden');
    startFakeProgress();

    try {
      const res = await fetch(`${base}api/generate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (res.ok && data.success) {
        stopFakeProgress();
        setProgress(100);
        statusEl.className = 'mt-6 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800';
        statusText.innerHTML = `${data.count} Posts wurden erstellt. <a href="${base}kalender" class="font-medium underline">Zum Content-Kalender →</a>`;
        form.reset();
      } else {
        throw new Error(data.error || 'Unbekannter Fehler');
      }
    } catch (err) {
      stopFakeProgress();
      progressWrap.classList.add('hidden');
      statusEl.className = 'mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800';
      statusText.textContent = `Fehler beim Generieren: ${err instanceof Error ? err.message : 'Unbekannter Fehler'}`;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '10 Posts generieren';
    }
  });
</script>
