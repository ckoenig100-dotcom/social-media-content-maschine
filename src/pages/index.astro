---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';
import { supabase, PLATFORMS, getEffectiveSettings, type PlatformSetting, type Profile } from '../lib/supabase';

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const user = await getCurrentUser(Astro.cookies);

let profileName: string | null = null;
let plan: 'free' | 'paid' = 'free';
let effective = getEffectiveSettings('free', {});

if (user) {
  const { data: profileData } = await supabase.from('profiles').select('*').eq('id', user.id).single();
  const profile = profileData as Profile | null;
  profileName = profile?.name ?? null;
  plan = profile?.plan ?? 'free';

  const { data } = await supabase.from('platform_settings').select('*').eq('user_id', user.id);
  const settings = (data ?? []) as PlatformSetting[];
  const byPlatform = Object.fromEntries(settings.map((s) => [s.platform, s]));
  effective = getEffectiveSettings(plan, byPlatform);
}

const activePlatforms = PLATFORMS.filter((p) => effective[p].active && effective[p].post_count > 0);
const totalPosts = activePlatforms.reduce((sum, p) => sum + effective[p].post_count, 0);
const platformNamesText =
  activePlatforms.length > 0
    ? activePlatforms.join(', ').replace(/, ([^,]*)$/, ' und $1')
    : 'keiner Plattform (bitte Einstellungen prüfen)';
---

<Layout title="Neuer Beitrag">
  <div class="mx-auto max-w-xl">
    {user && (
      <p class="mb-4 text-xs font-medium text-slate-400">
        Angemeldet als {profileName || user.email}
      </p>
    )}

    <h1 class="text-2xl font-semibold tracking-tight">Neuen Content generieren</h1>
    <p class="mt-1 text-sm text-slate-500">
      Aus einem Thema werden automatisch {totalPosts} Posts für {platformNamesText} erstellt.
    </p>

    {user && plan !== 'paid' && (
      <p class="mt-2 text-xs text-slate-400">
        Im kostenlosen Plan sind nur LinkedIn und Facebook aktiv. Weitere Plattformen sowie Anzahl und
        Textlänge lassen sich mit einem bezahlten Plan individuell einstellen.
      </p>
    )}

    {!user && (
      <div class="mt-8 rounded-md border border-blue-200 bg-blue-50 p-4 text-sm text-blue-800">
        <p>Melde dich an, um Content zu generieren.</p>
        <p class="mt-2">
          Im kostenlosen Plan werden automatisch Posts für LinkedIn und Facebook erstellt. Weitere
          Plattformen sowie das Anpassen von Anzahl, Textlänge und automatisiertes Posting sind
          kostenpflichtigen Plänen vorbehalten.
        </p>
        <div class="mt-3 flex gap-2">
          <a
            href={`${base}login`}
            class="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700"
          >
            Anmelden
          </a>
          <a
            href={`${base}registrieren`}
            class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >
            Registrieren
          </a>
        </div>
      </div>
    )}

    {user && (
      <>
        <form id="generate-form" class="mt-8 space-y-5">
          <div>
            <label for="thema" class="block text-sm font-medium text-slate-700">Thema *</label>
            <input
              id="thema"
              name="thema"
              type="text"
              required
              placeholder="z. B. Produktivität im Homeoffice"
              class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
            />
          </div>

          <div>
            <label for="kontext" class="block text-sm font-medium text-slate-700">Kontext</label>
            <textarea
              id="kontext"
              name="kontext"
              rows="3"
              placeholder="Zusätzlicher Kontext, Artikel-Auszug, Kernaussagen..."
              class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
            ></textarea>
          </div>

          <div>
            <label for="markenstimme" class="block text-sm font-medium text-slate-700">Markenstimme</label>
            <input
              id="markenstimme"
              name="markenstimme"
              type="text"
              placeholder="z. B. locker, professionell, humorvoll"
              class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
            />
          </div>

          <div>
            <label for="zielgruppe" class="block text-sm font-medium text-slate-700">Zielgruppe</label>
            <input
              id="zielgruppe"
              name="zielgruppe"
              type="text"
              placeholder="z. B. Freelancer, B2B-Entscheider"
              class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
            />
          </div>

          <div>
            <label for="kunde" class="block text-sm font-medium text-slate-700">Kunde (optional)</label>
            <input
              id="kunde"
              name="kunde"
              type="text"
              placeholder="Falls als Agentur-Service für einen Kunden"
              class="mt-1.5 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
            />
          </div>

          <button
            id="submit-btn"
            type="submit"
            class="w-full rounded-md bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {totalPosts} Posts generieren
          </button>
        </form>

        <div id="status" class="mt-6 hidden rounded-md border p-4 text-sm">
          <p id="status-text"></p>
          <div id="progress-wrap" class="mt-3 hidden">
            <div class="h-2 w-full overflow-hidden rounded-full bg-slate-200">
              <div id="progress-bar" class="h-full w-0 rounded-full bg-slate-900 transition-[width] duration-500 ease-out"></div>
            </div>
            <p id="progress-percent" class="mt-1 text-right text-xs text-slate-400">0%</p>
          </div>
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  const form = document.getElementById('generate-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const statusEl = document.getElementById('status') as HTMLDivElement | null;
  const statusText = document.getElementById('status-text') as HTMLParagraphElement | null;
  const progressWrap = document.getElementById('progress-wrap') as HTMLDivElement | null;
  const progressBar = document.getElementById('progress-bar') as HTMLDivElement | null;
  const progressPercent = document.getElementById('progress-percent') as HTMLParagraphElement | null;

  let progressTimer: ReturnType<typeof setInterval> | undefined;

  function setProgress(percent: number) {
    if (progressBar) progressBar.style.width = `${percent}%`;
    if (progressPercent) progressPercent.textContent = `${Math.round(percent)}%`;
  }

  function startFakeProgress() {
    const startTime = Date.now();
    setProgress(0);
    progressTimer = setInterval(() => {
      const elapsedSeconds = (Date.now() - startTime) / 1000;
      const percent = 92 * (1 - Math.exp(-elapsedSeconds / 40));
      setProgress(percent);
    }, 300);
  }

  function stopFakeProgress() {
    if (progressTimer) clearInterval(progressTimer);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !statusEl || !statusText || !progressWrap) return;

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    submitBtn.disabled = true;
    const originalLabel = submitBtn.textContent;
    submitBtn.textContent = 'Generiere Posts... (kann bis zu 2 Minuten dauern)';
    statusEl.className = 'mt-6 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-600';
    statusText.textContent = 'Claude erstellt gerade deine Posts und speichert sie in deinem Content-Kalender. Bitte warten...';
    progressWrap.classList.remove('hidden');
    startFakeProgress();

    try {
      const res = await fetch(`${base}api/generate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (res.ok && data.success) {
        stopFakeProgress();
        setProgress(100);
        statusEl.className = 'mt-6 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-800';
        statusText.innerHTML = `${data.count} Posts wurden erstellt. <a href="${base}kalender" class="font-medium underline">Zum Content-Kalender →</a>`;
        form.reset();
      } else {
        throw new Error(data.error || 'Unbekannter Fehler');
      }
    } catch (err) {
      stopFakeProgress();
      progressWrap.classList.add('hidden');
      statusEl.className = 'mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800';
      statusText.textContent = `Fehler beim Generieren: ${err instanceof Error ? err.message : 'Unbekannter Fehler'}`;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalLabel;
    }
  });
</script>
