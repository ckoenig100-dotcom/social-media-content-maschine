---
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<footer class="border-t border-slate-200 bg-slate-50">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-4 py-8 text-sm text-slate-600 sm:flex-row sm:justify-between sm:px-6">
		<p>&copy; 2026 Christian König</p>
		<nav aria-label="Rechtliches">
			<ul class="flex items-center gap-4">
				<li><a href="mailto:chris@live.at" class="inline-flex min-h-11 items-center hover:text-slate-900 hover:underline">Kontakt</a></li>
				<li><a href={`${base}impressum`} class="inline-flex min-h-11 items-center hover:text-slate-900 hover:underline">Impressum</a></li>
				<li><a href={`${base}datenschutz`} class="inline-flex min-h-11 items-center hover:text-slate-900 hover:underline">Datenschutz</a></li>
			</ul>
		</nav>
	</div>
</footer>
