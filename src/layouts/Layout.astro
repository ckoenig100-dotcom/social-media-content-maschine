---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { getCurrentUser } from '../lib/auth';
import { supabase } from '../lib/supabase';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = base.replace(/\/$/, '') || '/';
const kalenderHref = `${base}kalender`;
const monatHref = `${base}kalender-monat`;
const profilHref = `${base}profil`;
const einstellungenHref = `${base}einstellungen`;
const adminHref = `${base}admin`;
const loginHref = `${base}login`;
const registrierenHref = `${base}registrieren`;

const user = await getCurrentUser(Astro.cookies);
let isAdmin = false;
if (user) {
  const { data } = await supabase.from('profiles').select('is_admin').eq('id', user.id).single();
  isAdmin = data?.is_admin ?? false;
}

function isActive(href: string) {
  return path === href.replace(/\/$/, '') ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100';
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Content Maschine</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
        <a href={base} class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <img src={`${base}profil.jpg`} alt="" class="h-8 w-8 rounded-full border border-slate-200 object-cover" />
          Social-Media-Content-Maschine
        </a>

        <nav class="flex flex-wrap items-center gap-1 text-sm">
          <a href={base} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(homePath)}`}>
            Neuer Beitrag
          </a>
          {user && (
            <>
              <a href={kalenderHref} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(kalenderHref)}`}>
                Content-Kalender
              </a>
              <a href={monatHref} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(monatHref)}`}>
                Monatskalender
              </a>
              <a href={einstellungenHref} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(einstellungenHref)}`}>
                Einstellungen
              </a>
              <a href={profilHref} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(profilHref)}`}>
                Profil
              </a>
              {isAdmin && (
                <a href={adminHref} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(adminHref)}`}>
                  Admin
                </a>
              )}
              <button
                id="logout-btn"
                class="rounded-md px-3 py-1.5 text-blue-600 transition-colors hover:bg-blue-50"
              >
                Abmelden
              </button>
            </>
          )}
          {!user && (
            <>
              <a href={loginHref} class={`rounded-md px-3 py-1.5 transition-colors ${isActive(loginHref)}`}>
                Anmelden
              </a>
              <a
                href={registrierenHref}
                class="rounded-md bg-slate-900 px-3 py-1.5 font-medium text-white transition-colors hover:bg-slate-700"
              >
                Registrieren
              </a>
            </>
          )}
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    await fetch(`${base}api/auth/logout`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    window.location.href = `${base}login`;
  });
</script>
