---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = base.replace(/\/$/, '') || '/';
const kalenderHref = `${base}kalender`;
const monatHref = `${base}kalender-monat`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Content Maschine</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
        <a href={base} class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <img src={`${base}profil.jpg`} alt="" class="h-8 w-8 rounded-full border border-slate-200 object-cover" />
          Social-Media-Content-Maschine
        </a>
        <nav class="flex gap-1 text-sm">
          <a
            href={base}
            class={`rounded-md px-3 py-1.5 transition-colors ${
              path === homePath ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            Neuer Beitrag
          </a>
          <a
            href={kalenderHref}
            class={`rounded-md px-3 py-1.5 transition-colors ${
              path === kalenderHref.replace(/\/$/, '') ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            Content-Kalender
          </a>
          <a
            href={monatHref}
            class={`rounded-md px-3 py-1.5 transition-colors ${
              path === monatHref.replace(/\/$/, '') ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            Monatskalender
          </a>
        </nav>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
