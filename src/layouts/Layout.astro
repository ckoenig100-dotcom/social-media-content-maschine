---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = base.replace(/\/$/, '') || '/';
const kalenderHref = `${base}kalender`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Content Maschine</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6">
        <a href={base} class="text-lg font-semibold tracking-tight">Social-Media-Content-Maschine</a>
        <nav class="flex gap-1 text-sm">
          <a
            href={base}
            class={`rounded-md px-3 py-1.5 transition-colors ${
              path === homePath ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            Neuer Beitrag
          </a>
          <a
            href={kalenderHref}
            class={`rounded-md px-3 py-1.5 transition-colors ${
              path === kalenderHref.replace(/\/$/, '') ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            Content-Kalender
          </a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <slot />
    </main>
  </body>
</html>
